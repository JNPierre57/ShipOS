{
  "name": "shipos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config apps/overlay/vite.config.ts && vite build --config apps/control-panel/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run build:node && vitest run tests/integration",
    "test:golden": "vitest run tests/golden",
    "test:e2e": "playwright test",
    "test:architecture": "node scripts/architecture.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "verify:final": "npm run verify && npm run test:golden && npm run test:e2e && npm run test:architecture",
    "start:core": "node dist/apps/core/src/main.js",
    "start:agent": "node dist/apps/agent/src/main.js",
    "build:node": "tsc -p tsconfig.build.json",
    "build:agent": "tsc -p apps/agent/tsconfig.json",
    "package:agent": "npm run build:agent && node scripts/package-agent.mjs",
    "restore": "node scripts/restore.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\" \"modules/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.mjs\"",
    "verify:agent-install": "node scripts/verify-agent-install.mjs",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
